{
    "id": "cursorHighlight",
    "name": "Cursor Highlight",
    "description": "Overlay under the cursor for presentations and screen sharing",
    "version": "1.2.0",
    "license": "MIT",
    "author": "ReyArlena",
    "icon": "my_location",
    "type": "composite",
    "capabilities": [
        "daemon",
        "dankbar-widget",
        "ipc"
    ],
    "components": {
        "daemon": "./CursorHighlight.qml",
        "widget": "./CursorHighlightWidget.qml"
    },
    "settings": "./CursorHighlightSettings.qml",
    "startupCheck": "./StartupCheck.qml",
    "requires_dms": ">=1.5.0",
    "permissions": [
        "settings_read",
        "settings_write"
    ]
}
